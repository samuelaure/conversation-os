# Environment — local development
# Copy this to .env and fill in real values. Never commit .env

# PostgreSQL
POSTGRES_USER=cos_user
POSTGRES_PASSWORD=cos_pass
POSTGRES_DB=cos_db

# Redis
REDIS_PASSWORD=cos_redis_pass

# NestJS API
DATABASE_URL="postgresql://cos_user:cos_pass@localhost:5433/cos_db?schema=public"
REDIS_URL=redis://:cos_redis_pass@localhost:6379

# Apify
APIFY_TOKEN=your_apify_token_here

# App
NODE_ENV=development
PORT=3001
